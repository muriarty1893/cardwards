{
  // Dream Isles online relay: one Worker, a Lobby DO (quick match) and a Room DO per room code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dream-isles-online",
  "main": "src/index.ts",
  // Not newer than the test pool's bundled runtime (workerd 1.20260815).
  "compatibility_date": "2026-08-15",
  // Served at https://dream-isles-online.dream-isles-online.workers.dev (no preview URLs).
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "GATE", "class_name": "Gate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] },
    { "tag": "v2", "new_sqlite_classes": ["Gate"] }
  ],
  "observability": { "enabled": true }
}
