extends SceneTree
## Writes core/rules_stamp.gd from the current core/*.gd sources (part of the online version).
##   godot --headless --path . --script res://tools/stamp_rules.gd


func _initialize() -> void:
	var h: String = NetVersion.rules_source_hash()
	var f := FileAccess.open(NetVersion.STAMP_FILE, FileAccess.WRITE)
	f.store_string("class_name RulesStamp\nextends RefCounted\n## Generated by tools/stamp_rules.gd: md5 of the core/*.gd sources. Do not edit.\n\nconst HASH := \"%s\"\n" % h)
	f.close()
	print("rules stamp ", h)
	quit(0)
