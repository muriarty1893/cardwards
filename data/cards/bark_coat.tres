[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_bark_coat_0"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"buff"
amount = 2
amount2 = 2
who = &"chosen_creature"

[sub_resource type="Resource" id="eff_bark_coat_1"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"give_keyword"
who = &"same_target"
keyword = &"guard"

[resource]
script = ExtResource("1_card")
id = &"bark_coat"
display_name = "Bark Coat"
kind = 2
cost = 2
effects = Array[ExtResource("2_eff")]([SubResource("eff_bark_coat_0"), SubResource("eff_bark_coat_1")])
