[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_thorn_lash_0"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"damage"
amount = 4
who = &"chosen_enemy_creature"

[sub_resource type="Resource" id="eff_thorn_lash_1"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"damage"
amount = 1
who = &"other_enemies"

[resource]
script = ExtResource("1_card")
id = &"thorn_lash"
display_name = "Thorn Lash"
kind = 2
cost = 4
effects = Array[ExtResource("2_eff")]([SubResource("eff_thorn_lash_0"), SubResource("eff_thorn_lash_1")])
