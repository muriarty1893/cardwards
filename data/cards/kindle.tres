[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="2_eff"]

[sub_resource type="Resource" id="Eff_kindle_0"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"damage"
amount = 3
who = &"chosen_creature"

[sub_resource type="Resource" id="Eff_kindle_1"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"dream_up"
filter_land = 1
combo = true

[resource]
script = ExtResource("1_card")
id = &"kindle"
display_name = "Kindle"
kind = 2
land = 1
cost = 2
effects = Array[ExtResource("2_eff")]([SubResource("Eff_kindle_0"), SubResource("Eff_kindle_1")])
