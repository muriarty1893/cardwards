[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_stoke_0"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"damage"
amount = 1
who = &"chosen_own_creature"

[sub_resource type="Resource" id="eff_stoke_1"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"buff"
amount = 2
who = &"same_target"

[resource]
script = ExtResource("1_card")
id = &"stoke"
display_name = "Stoke"
kind = 2
land = 1
cost = 0
effects = Array[ExtResource("2_eff")]([SubResource("eff_stoke_0"), SubResource("eff_stoke_1")])
