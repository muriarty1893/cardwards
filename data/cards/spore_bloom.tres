[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="1_effect"]

[sub_resource type="Resource" id="Resource_lb_spore_bloo_0"]
script = ExtResource("1_effect")
