[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_mossback_colossus_0"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"armour"
amount = 2
who = &"own_hero"

[sub_resource type="Resource" id="eff_mossback_colossus_1"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"buff"
amount2 = 1
who = &"all_own_creatures"

[resource]
script = ExtResource("1_card")
id = &"mossback_colossus"
display_name = "Mossback Colossus"
level = 1
cost = 5
attack = 4
health = 8
keywords = Array[StringName]([&"guard"])
tribe = &"blob"
effects = Array[ExtResource("2_eff")]([SubResource("eff_mossback_colossus_0"), SubResource("eff_mossback_colossus_1")])
collectible = false
