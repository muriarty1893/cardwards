[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_snowdrift_cache_0"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"damage"
who = &"all_enemy_creatures"
amount = 1

[sub_resource type="Resource" id="eff_snowdrift_cache_1"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"shuffle_into_deck"
who = &"own_hero"
card_id = &"frost_shard"
amount = 2

[resource]
script = ExtResource("1_card")
id = &"snowdrift_cache"
display_name = "Snowdrift Cache"
kind = 2
land = 3
level = 0
cost = 3
effects = Array[ExtResource("2_eff")]([SubResource("eff_snowdrift_cache_0"), SubResource("eff_snowdrift_cache_1")])
