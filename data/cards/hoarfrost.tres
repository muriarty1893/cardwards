[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_hoarfrost_0"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"draw"
who = &"own_hero"
amount = 1

[sub_resource type="Resource" id="eff_hoarfrost_1"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"draw"
who = &"own_hero"
need_cond = &"holding_land:3"
amount = 1

[resource]
script = ExtResource("1_card")
id = &"hoarfrost"
display_name = "Hoarfrost"
kind = 2
land = 3
level = 0
cost = 2
effects = Array[ExtResource("2_eff")]([SubResource("eff_hoarfrost_0"), SubResource("eff_hoarfrost_1")])
