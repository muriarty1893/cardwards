[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_ember_cache_0"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"damage"
who = &"enemy_hero"
amount = 1

[sub_resource type="Resource" id="eff_ember_cache_1"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"shuffle_into_deck"
who = &"own_hero"
card_id = &"ember_spark"
amount = 2

[resource]
script = ExtResource("1_card")
id = &"ember_cache"
display_name = "Ember Cache"
kind = 2
land = 1
level = 0
cost = 2
effects = Array[ExtResource("2_eff")]([SubResource("eff_ember_cache_0"), SubResource("eff_ember_cache_1")])
