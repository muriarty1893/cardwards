[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="2_eff"]

[sub_resource type="Resource" id="eff_buried_treasure_0"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"armour"
who = &"own_hero"
amount = 2

[sub_resource type="Resource" id="eff_buried_treasure_1"]
script = ExtResource("2_eff")
when = &"on_play"
op = &"shuffle_into_deck"
who = &"own_hero"
card_id = &"sun_coin"
amount = 2

[resource]
script = ExtResource("1_card")
id = &"buried_treasure"
display_name = "Buried Treasure"
kind = 2
land = 5
level = 0
cost = 2
effects = Array[ExtResource("2_eff")]([SubResource("eff_buried_treasure_0"), SubResource("eff_buried_treasure_1")])
