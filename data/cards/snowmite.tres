[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://core/effect_data.gd" id="1_yw6ar"]

[sub_resource type="Resource" id="Resource_8oach"]
script = ExtResource("1_yw6ar")
when = &"on_boop"
op = &"freeze"
who = &"opposing"

[sub_resource type="Resource" id="Resource_lb_snowmite_0"]
script = ExtResource("1_yw6ar")
when = &"on_level_up"
op = &"freeze"
who = &"opposing"

[resource]
script = ExtResource("1_card")
id = &"snowmite"
display_name = "Snowmite"
land = 3
level = 1
cost = 2
attack = 1
health = 3
effects = Array[ExtResource("1_yw6ar")]([SubResource("Resource_8oach"), SubResource("Resource_lb_snowmite_0")])
tribe = &"beast"
